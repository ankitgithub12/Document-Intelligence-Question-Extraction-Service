# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.iwubpjgytnilycsfisxp.supabase.co:5432/postgres
DATABASE_URL_SYNC=postgresql://postgres:[YOUR-PASSWORD]@db.iwubpjgytnilycsfisxp.supabase.co:5432/postgres

# Redis
REDIS_URL=redis://redis:6379/0

# JWT Authentication
JWT_SECRET=change-me-to-a-secure-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# File Upload
MAX_FILE_SIZE_MB=25
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png

# Storage (options: local, cloudinary)
STORAGE_PROVIDER=cloudinary
LOCAL_STORAGE_PATH=./storage

# Cloudinary (required when STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=document-intelligence

# OCR
OCR_PROVIDER=tesseract

# AI Provider (leave empty to use heuristic fallback)
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# Confidence Thresholds
CONFIDENCE_EXTRACTED_THRESHOLD=0.85
CONFIDENCE_PARTIAL_THRESHOLD=0.60

# CORS & Production Domains (In production, replace with your frontend domain(s) or *)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# APP_URL=https://api.yourdomain.com
# FRONTEND_URL=https://yourdomain.com

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

