# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://docai_user:docai_password@postgres:5432/document_intelligence
DATABASE_URL_SYNC=postgresql://docai_user:docai_password@postgres:5432/document_intelligence

# Redis
REDIS_URL=redis://redis:6379/0

# JWT Authentication
JWT_SECRET=change-me-to-a-secure-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# File Upload
MAX_FILE_SIZE_MB=25
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png

# Storage
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./storage

# OCR
OCR_PROVIDER=tesseract

# AI Provider (leave empty to use heuristic fallback)
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# Confidence Thresholds
CONFIDENCE_EXTRACTED_THRESHOLD=0.85
CONFIDENCE_PARTIAL_THRESHOLD=0.60

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
